# ──────────────────────────────────────────────
#  Disc Ripper Pro — .gitignore
# ──────────────────────────────────────────────

# ── Python & Environments ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.venv/
venv/
env/
ENV/
.env

# ── PyInstaller & Build Outputs ───────────────
build/
dist/
*.spec
!Disc Ripper Pro.spec
*.manifest

# ── Release & Packaging Artifacts ─────────────
# Portable builds, archives and release distributions
[Rr]elease/
release/
Release/
*Portable*/
*_Portable/
*.zip
*.7z
*.rar
*.tar.gz

# ── Bundled Binary Tools & Engines ────────────
# Heavy CLI tools and binaries (FFmpeg, HandBrakeCLI, etc.)
ffmpeg/
handbrake/
handbreak/
tools/
bin/
*.exe
*.dll
*.so
*.dylib

# ── Ripped Media & Output Files ───────────────
# Never commit optical disc extraction outputs
*.dat
*.mpg
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.ac3
*.flac
*_Chapter_Timeline.txt
[Oo]utput/
[Rr]ips/

# ── Runtime, Config & Temporary Files ─────────
config.json
*.log
*.tmp
*.bak
*.swp
*.swo
*.dmp
*.crash

# ── IDE & Editor Files ────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Testing & Code Quality ────────────────────
.pytest_cache/
.coverage
htmlcov/
tests/__pycache__/

# ── OS / System Files ─────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
